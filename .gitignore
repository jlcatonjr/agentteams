__pycache__/
*.pyc
*.pyo
.venv/
dist/
# setuptools' intermediate staging tree, created by `pip wheel .`, `pip install -e .`,
# and `python -m build`. It holds a full copy of agentteams/, which the code-hygiene
# guards (git ls-files --others --exclude-standard) would otherwise scan as a second
# set of source files — producing phantom duplicate-definition failures.
build/
*.egg-info/
.DS_Store
.pytest_cache/
htmlcov/
*.swp
*.swa
*~

# Generated agent team for this repo — excluded because the team's
# knowledge of the module's internals could compromise the repository
# if exposed as context to external users.
# Uses /* instead of / so we can un-ignore _build-description.json for CI.
.github/agents/*
.github/copilot-instructions.md

# Build-time intake artifacts (written by the team-builder agent)
_build-description.json
_intake-notes.md
# Un-ignore the self-team description so CI can run security-maintenance.
# Must come AFTER the _build-description.json pattern above (last rule wins).
!.github/agents/_build-description.json

# Planning and step CSVs
build-team-steps.csv
tool-enrichment-steps.csv

# Automatic pre-write backups created by build_team.py
.agentteams-backups/

# Single-generation backup written before codex_mcp_emit.py splices
# .codex/config.toml (lives at the project root, outside .agentteams-backups/)
.codex/config.toml.bak

# MkDocs local build output — rebuilt by CI; never committed
_site/

# Operational scratch space — contains absolute machine paths and private repo names (OPSEC S-1)
# Nothing in tmp/ should ever be committed; sanitize before moving anything to a permanent location
tmp/

# Harness-generated, machine-local permission state (RRM1). Scoped to the single
# file — other .claude/ files (README.md, agent-team.md, quickstart-snippet.md)
# are tracked and must NOT be ignored.
.claude/settings.json

# Daily work summaries — operational logs and tracking documents
# Contains execution dates, timestamps, and per-repo status; not for publication
workSummaries/

# Operational session artifacts relocated to a private work-docs repo
# (work docs / audit outputs; not for publication). Tightly scoped so canonical
# published references under references/ stay tracked. See
# references/plans/work-docs-option-a-2026-08-26.plan.md.
references/goose-*-2026-*.adversarial.md
references/goose-*-2026-*.conflict-audit.md
references/typing-audit-closeout-2026-*.adversarial.md
references/typing-audit-closeout-2026-*.conflict-audit.md
references/security-posture-*-2026-*.csv
references/changelog-review-2026-*.conflict.csv
references/openweights-security-model-eval.report.md
references/systematic-update-lessons.md
references/fleet-update-scope-boundary.md

# Canonical home for RETAINED local planning/operation docs (plans, feasibility
# reports, investigations, change reports) — not for publication; may contain
# machine-specific paths and org/repo names. See references/filing-conventions.md.
# Plan documents must NEVER be written to the repo root (guard: tests/test_root_doc_hygiene.py).
references/plans/

# Generated bridge-merge run reports — regenerated by the bridge tooling and
# contain machine-specific absolute paths; keep local, never publish.
references/bridges/**/bridge-merge.report.md

# Code & API vector index (F-CODEIDX) — a gitignored local retrieval cache
# rebuilt on demand (agentteams --refresh-code-index / --query-code / --update).
# The api-* partitions embed machine-specific resolved paths & installed
# versions; keep local, never commit. See references/plans/code-api-vector-index.plan.md.
# The `**/` form matters: `.claude/` is an explicitly TRACKED tree, so a
# `.claude/agents/references/code-index/` build would otherwise be committable.
# (The `.github/agents/` copy escapes only incidentally, via the `.github/agents/*`
# rule above.) Root-anchored `references/code-index/` alone is not enough.
references/code-index/
**/references/code-index/

# External-retrieval TTL cache (agentteams/research/cache.py) — search/fetch/scholar responses
# from third-party endpoints, keyed by SHA-256 digest. Untrusted external bytes and
# operator-local by nature; rebuilt on demand and safe to delete at any time. Never commit.
references/research-cache/
**/references/research-cache/

# Structural or audit plan docs committed during development
docs_src/structural-update-plan.md
python

# Stale root-level templates/ — canonical copy is agentteams/templates/
/templates/

# Ignored SVG build artifacts under docs/book/figures/ (hand-authored figures are
# allowlisted with '!' below). NOTE: the architecture graph SVGs live under references/
# and ARE tracked (references/architecture-graph.svg, architecture-modules.svg); the
# pipeline graph SVGs live in the agent dir's references/ (.github/agents/references/).
# Regenerate: agentteams --refresh-graph / --refresh-architecture.
docs/book/figures/*.svg
docs_src/book/figures/*.svg
!docs/book/figures/agent-team-structure.svg
!docs_src/book/figures/agent-team-structure.svg
!docs/book/figures/workflow-12-adaptive-plan-execution.svg
!docs_src/book/figures/workflow-12-adaptive-plan-execution.svg

# memory-index validation sidecar cache — machine-specific local cache, never committed
# (added with the validation-cache perf fix; keeps test_root_doc_hygiene / untracked-artifact checks clean)
references/memory-index.vcache
**/references/memory-index.vcache

# Goose cost-monitoring tooling — local operator tooling, never committed.
# Untracked at the time these rules were added, so no `git rm --cached` was needed.
# Note: .gitignore'd paths are also excluded from tests/test_code_hygiene.py's scan
# (it enumerates via `git ls-files --cached --others --exclude-standard`), so these
# files no longer count toward the CH-24 broad-except / swallowed-exception baselines.
scripts/goose-cost-proxy.py
scripts/cost-monitor-app.html
scripts/gooseCostMonitor/

# Generated check report, written beside the recipes by `--recipe-check`
# (agentteams/cli/recipe_check.py:62). Constitutional Rule 4: build artifacts are
# derived, never primary — and this one is untracked but was NOT ignored, so the
# next `git add -A` would have committed it.
.goose/recipes/recipe-check.report.md

# MkDocs build output. NOT what serves the site: GitHub Pages is build_type=workflow, and
# .github/workflows/docs.yml builds with `--site-dir _site` and deploys that artifact via
# actions/deploy-pages. The committed copy was a 180-file tree nobody consumed, refreshed
# only when a contributor happened to run a bare `mkdocs build` — and it had drifted
# (missing template-pins/ and front-matter-reconcile/; cli-reference last built 2026-07-29).
# `site_dir` below now matches CI so local and CI builds agree. Audit finding D-6.
docs/

# Red-team battery results, written only when the battery is run standalone.
tests/constitutional-redteam-results.json

# Multi-framework pinned-sync artifacts — instance/operational state (the exploded
# canonical team, the pin, per-framework baselines, and the conflict log). These
# describe THIS repo's own agent instance and must never be published.
.agentteams/canonical/
.agentteams/pin.json
.agentteams/sync-conflicts.log.csv

# Instance-privacy (operator decision 2026-08-13, land-uncommitted-tree plan step 1):
# further instance-state surfaces of this repo's own agent teams — the durable
# canonical exploded team at the root, the copilot-cli renders, and runtime handoff
# state. Same never-publish class as .agentteams/ above. At decision time these
# also carried unremediated wrong-value-bleed content (remediation-log 2026-08-13).
# Known exception: .github/copilot/bridge-entry.md was committed before this rule
# (6c284e1) and stays tracked — gitignore does not untrack it. It is the generic
# 4-line bridge-entry pointer (no instance data), kept published deliberately.
.agents/
.github/copilot/
.claude/references/runtime-handoffs.json
.claude/agents/references/runtime-handoffs.json
.goose/recipes/
references/runtime-handoffs.json
.github/references/

# agentteams-research/ is a single, independent PRIVATE research repository (its own .git),
# gitignored here so its contents are access-gated by that separate repo rather than tracked by
# agentteams. Renamed from research/ on 2026-08-21 (consolidated to one research repo).
/agentteams-research/
/research/

# Local environment / VM credentials (never commit)
.env

