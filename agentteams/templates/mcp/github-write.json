{
  "artifact_type": "mcp-server",
  "mcp_server_schema_version": "1.0",
  "server_id": "github-write",
  "domain": "github",
  "description": "GitHub's official MCP server limited by an exact tool allowlist: reads plus branch, file, PR and issue writes. No merge, no file or repository deletion, no fork. Inert until the operator activates it.",
  "trust_tier": "third-party-vetted",
  "transport": "stdio",
  "command": "github-mcp-server",
  "args": [
    "stdio",
    "--tools",
    "get_me,get_file_contents,get_repository,get_repository_tree,list_branches,list_commits,get_commit,list_issues,search_issues,issue_read,list_pull_requests,search_pull_requests,pull_request_read,create_branch,create_or_update_file,push_files,create_pull_request,update_pull_request,issue_write,add_issue_comment"
  ],
  "auth": {
    "mechanism": "env",
    "credential_ref": "GITHUB_PERSONAL_ACCESS_TOKEN"
  },
  "tools": [
    {
      "name": "get_me",
      "side_effects": "read"
    },
    {
      "name": "get_file_contents",
      "side_effects": "read"
    },
    {
      "name": "get_repository",
      "side_effects": "read"
    },
    {
      "name": "get_repository_tree",
      "side_effects": "read"
    },
    {
      "name": "list_branches",
      "side_effects": "read"
    },
    {
      "name": "list_commits",
      "side_effects": "read"
    },
    {
      "name": "get_commit",
      "side_effects": "read"
    },
    {
      "name": "list_issues",
      "side_effects": "read"
    },
    {
      "name": "search_issues",
      "side_effects": "read"
    },
    {
      "name": "issue_read",
      "side_effects": "read"
    },
    {
      "name": "list_pull_requests",
      "side_effects": "read"
    },
    {
      "name": "search_pull_requests",
      "side_effects": "read"
    },
    {
      "name": "pull_request_read",
      "side_effects": "read"
    },
    {
      "name": "create_branch",
      "side_effects": "write"
    },
    {
      "name": "create_or_update_file",
      "side_effects": "write"
    },
    {
      "name": "push_files",
      "side_effects": "write"
    },
    {
      "name": "create_pull_request",
      "side_effects": "write"
    },
    {
      "name": "update_pull_request",
      "side_effects": "write"
    },
    {
      "name": "issue_write",
      "side_effects": "write"
    },
    {
      "name": "add_issue_comment",
      "side_effects": "write"
    }
  ],
  "scope": [],
  "progressive_disclosure": "lazy",
  "security_review": {
    "required": true,
    "authorized_by": null,
    "authorized_at": null
  },
  "catalog_default": false,
  "role_scope": [
    "orchestrator",
    "git-operations"
  ],
  "pin": {
    "package": "github-mcp-server",
    "version": "v2.0.1",
    "tools_verified_version": "v2.0.1",
    "source": "https://github.com/github/github-mcp-server/releases/tag/v2.0.1",
    "digest": null,
    "verified_at": "2026-10-07",
    "note": "Install this exact release; record its sha256 (or the ghcr.io image digest) in security_review at vetting (S-10, C4). Tool names are v2.0.1's; recheck them on any upgrade."
  }
}
