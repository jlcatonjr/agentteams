#!/bin/sh
# git credential helper for the vulnscan tools container: answers `get` with the token vulnscan-with-token
# read from stdin, and only for protocol=https and host == VULNSCAN_GIT_HOST. `store`/`erase` do nothing.
[ "$1" = get ] || exit 0
proto=""; host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) proto="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
  esac
done
[ "$proto" = https ] && [ -n "${VULNSCAN_GIT_HOST:-}" ] && [ "$host" = "$VULNSCAN_GIT_HOST" ] \
  && [ -n "${VULNSCAN_GIT_TOKEN:-}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$VULNSCAN_GIT_TOKEN"
