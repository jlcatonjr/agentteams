    {
      "label": "agentteams: check drift (brief)",
      "type": "shell",
      "command": "agentteams --description \"${input:descriptionFile}\" --check",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Exit 0 = no drift, exit 1 = structural/knowledge drift detected."
    },
    {
      "label": "agentteams: update (merge, brief)",
      "type": "shell",
      "command": "agentteams --description \"${input:descriptionFile}\" --update --merge",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Re-render drifted files / emit new agents, preserving manual values."
    },
    {
      "label": "agentteams: scan security (brief)",
      "type": "shell",
      "command": "agentteams --description \"${input:descriptionFile}\" --scan-security",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Scan deployed agent files for PII, credentials, and unresolved placeholders."
    },
    {
      "label": "agentteams: fleet update (preview)",
      "type": "shell",
      "command": "agentteams --fleet \"${input:fleetRoot}\" --update --merge",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Dry-run preview of a multi-workspace merge update under a parent directory."
    },
    {
      "label": "agentteams: fleet update (apply)",
      "type": "shell",
      "command": "agentteams --fleet \"${input:fleetRoot}\" --update --merge --yes",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Apply the multi-workspace merge update (non-destructive, snapshots each workspace first)."
    },
    {
      "label": "bridge: merge (safe, fenced-only)",
      "type": "shell",
      "command": "agentteams --bridge-from \"${input:bridgeSource}\" --framework \"${input:bridgeFramework}\" --output \"${input:bridgeOutput}\" --bridge-merge",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Refresh only fenced (managed) bridge regions. Safe default; never use --bridge-refresh on shared files."
    },
    {
      "label": "bridge: check freshness",
      "type": "shell",
      "command": "agentteams --bridge-from \"${input:bridgeSource}\" --framework \"${input:bridgeFramework}\" --output \"${input:bridgeOutput}\" --bridge-check",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Validate bridge artifacts against source files (cannot be combined with --bridge-refresh)."
    },
    {
      "label": "docs: serve (live preview)",
      "type": "shell",
      "command": "mkdocs serve",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": [],
      "detail": "Serve the MkDocs site locally with live reload."
