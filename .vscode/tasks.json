{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install: editable + test deps",
      "type": "shell",
      "command": "pip install -e \".[test]\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Install agentteams in editable mode with pytest + pyyaml (CI: pip install -e .[test])."
    },
    {
      "label": "install: editable (runtime only)",
      "type": "shell",
      "command": "pip install -e .",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Install the runtime package only (no test extras)."
    },
    {
      "label": "test: full suite",
      "type": "shell",
      "command": "python -m pytest tests/ -v",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Run the full test suite verbosely (README: python -m pytest tests/ -v)."
    },
    {
      "label": "test: quiet",
      "type": "shell",
      "command": "python -m pytest tests/ -q",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Run the full test suite with minimal output."
    },
    {
      "label": "test: current file",
      "type": "shell",
      "command": "python -m pytest \"${file}\" -v",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Run pytest against the file currently open in the editor."
    },
    {
      "label": "test: root doc hygiene",
      "type": "shell",
      "command": "python -m pytest tests/test_root_doc_hygiene.py -v",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Enforces filing conventions: no stray plans/reports in the repo root (CLAUDE.md)."
