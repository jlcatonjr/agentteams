    {
      "label": "agentteams: self update (preview)",
      "type": "shell",
      "command": "agentteams --self --update --dry-run",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Preview what a self-maintenance update would change, without writing."
    },
    {
      "label": "agentteams: self update (apply)",
      "type": "shell",
      "command": "agentteams --self --update --merge --yes",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Non-destructive merge-only self update (the core of daily security maintenance)."
    },
    {
      "label": "agentteams: self regenerate meta-team",
      "type": "shell",
      "command": "agentteams --self",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Regenerate this module's own meta-agent team (README: Self-maintenance)."
    },
